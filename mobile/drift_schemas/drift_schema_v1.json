      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_inspections\" (\"id\" TEXT NOT NULL, \"owner\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"template_json\" TEXT NOT NULL, \"vehicle_json\" TEXT NOT NULL, \"server_version\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
