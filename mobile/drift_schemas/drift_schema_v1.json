      ]
    },
    {
      "name": "pending_operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_operations\" (\"sequence\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id\" TEXT NOT NULL UNIQUE, \"owner\" TEXT NOT NULL, \"inspection_id\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"blocked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"blocked\" IN (0, 1)), \"error\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "cached_objects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_objects\" (\"cache_key\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"cache_key\"));"
        }
      ]
    },
    {
      "name": "local_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_photos\" (\"id\" TEXT NOT NULL, \"owner\" TEXT NOT NULL, \"inspection_id\" TEXT NOT NULL, \"metadata\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL, \"uploaded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"uploaded\" IN (0, 1)), \"error\" TEXT NULL, PRIMARY KEY (\"id\"));"
